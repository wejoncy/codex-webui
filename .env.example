# Export these variables in your shell; Python does not load this file automatically.
CODEX_WEBUI_HOST=127.0.0.1
CODEX_WEBUI_PORT=8172
CODEX_WEBUI_WORKSPACE=.
CODEX_BIN=codex
# Connect to an existing app-server instead of spawning one:
# CODEX_APP_SERVER_URL=ws://127.0.0.1:4500
# CODEX_APP_SERVER_TOKEN=your-app-server-capability-token
# Protect the UI when exposing it beyond localhost:
# CODEX_WEBUI_TOKEN=choose-a-long-random-secret
